# Application
PORT=3100

# Rate Limiter
RATE_LIMIT_MAX=100
RATE_LIMIT_EXP_MINUTES=1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/golang_base?sslmode=disable
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/golang_base_e2e?sslmode=disable

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# SMTP Mailer Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@example.com

# JWT
JWT_SECRET=your-secret-key-change-in-production
TOKEN_ENCRYPT_KEY=change-this-to-32-char-secret-key

# OCR - OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OCR_OPENAI_MODEL=gpt-4.1-mini
OCR_MAX_FILE_BYTES=10485760        # 10MB in bytes

# Attachments - Storage
STORAGE_PROVIDER=local          # local | s3 | gcs
STORAGE_LOCAL_BASE_PATH=./storage/app/public
STORAGE_PUBLIC_BASE_URL=/storage
MAX_UPLOAD_SIZE=10485760        # 10MB in bytes

# Attachments - S3 (when STORAGE_PROVIDER=s3)
S3_BUCKET=your-bucket
S3_REGION=ap-southeast-1
S3_ENDPOINT=                   # Optional: for MinIO / custom endpoint
S3_ACCESS_KEY_ID=              # Optional: falls back to env/IAM
S3_SECRET_ACCESS_KEY=          # Optional: falls back to env/IAM
S3_FORCE_PATH_STYLE=false      # true for MinIO

# Attachments - GCS (when STORAGE_PROVIDER=gcs)
GCS_BUCKET=your-bucket
GCS_CREDENTIALS_JSON=          # Optional: JSON key, falls back to GOOGLE_APPLICATION_CREDENTIALS

# Seeder (optional)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=password
