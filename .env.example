# Application
APP_SERVICE=
PORT=3100

# Logging - debug | info | warn | error (default: info)
# Logs are JSON Lines written to logs/app.log plus one file per level:
# logs/debug.log, logs/info.log, logs/warn.log, logs/error.log
LOG_LEVEL=info
LOG_PRETTY=false            # true = human-readable lines for local dev

# Observability - Metrics
# Bearer token protecting GET /metrics. The endpoint is NOT mounted while this is
# empty, so an unset token can never expose metrics by accident.
# Keep this in sync with monitoring/prometheus/prometheus.yml (METRICS_TOKEN).
METRICS_TOKEN=

# Observability - Tracing (OpenTelemetry, OTLP/HTTP)
# Leave disabled unless a collector (e.g. Jaeger from monitoring/) is reachable.
TRACING_ENABLED=false
TRACING_SAMPLE_RATIO=1      # 0.0-1.0 head sampling for new traces
APP_VERSION=dev
APP_ENV=development
# Standard OTel exporter variables are read directly by the SDK:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_INSECURE=true

# Rate Limiter
RATE_LIMIT_MAX=100
RATE_LIMIT_EXP_MINUTES=1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/golang_base?sslmode=disable
E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/golang_base_e2e?sslmode=disable

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# SMTP Mailer Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
SMTP_FROM=noreply@example.com

# JWT
JWT_SECRET=your-secret-key-change-in-production
TOKEN_ENCRYPT_KEY=change-this-to-32-char-secret-key

# OCR - OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OCR_OPENAI_MODEL=gpt-4.1-mini
OCR_MAX_FILE_BYTES=10485760        # 10MB in bytes

# Attachments - Storage
STORAGE_PROVIDER=local          # local | s3 | gcs
STORAGE_LOCAL_BASE_PATH=./storage/app/public
STORAGE_PUBLIC_BASE_URL=/storage
MAX_UPLOAD_SIZE=10485760        # 10MB in bytes

# Attachments - S3 (when STORAGE_PROVIDER=s3)
S3_BUCKET=your-bucket
S3_REGION=ap-southeast-1
S3_ENDPOINT=                   # Optional: for MinIO / custom endpoint
S3_ACCESS_KEY_ID=              # Optional: falls back to env/IAM
S3_SECRET_ACCESS_KEY=          # Optional: falls back to env/IAM
S3_FORCE_PATH_STYLE=false      # true for MinIO

# Attachments - GCS (when STORAGE_PROVIDER=gcs)
GCS_BUCKET=your-bucket
GCS_CREDENTIALS_JSON=          # Optional: JSON key, falls back to GOOGLE_APPLICATION_CREDENTIALS

# Seeder (optional)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=password
